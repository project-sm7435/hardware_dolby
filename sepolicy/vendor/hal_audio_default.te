hal_client_domain(hal_audio_default, hal_dms)

# Xiaomi Sound (MiSound) calibration files under /vendor/lib/rfsa/adsp/ and persist.vendor.audio.*
allow hal_audio_default vendor_file:dir r_dir_perms;
allow hal_audio_default vendor_file:file r_file_perms;
set_prop(hal_audio_default, vendor_audio_prop)
