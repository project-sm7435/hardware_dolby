     Default Xiaomi Sound (MiSound) scenario profiles for libmisoundfx.so.
     Strictly 3 scenarios mapped to UI indices 0..2:
       0 = Smart  (native_scenario=4, auto_scenario=true)
       1 = Music  (native_scenario=1, music_mode=1)
       2 = Movie  (native_scenario=2, movie_mode=1, music_mode=0)
     eq_db: 10 ISO octave bands in dB (-12.0 .. +12.0):
       32Hz, 64Hz, 125Hz, 250Hz, 500Hz, 1kHz, 2kHz, 4kHz, 8kHz, 16kHz
-->
<misound_profiles version="1">
    <scenario
        id="0"
        name="smart"
        native_scenario="4"
        music_mode="1"
        movie_mode="0"
        surround_3d="true"
        surround_level="45"
        vocal_level="20"
        eq_db="2.0,1.5,1.0,0.5,0.0,0.0,0.5,1.0,1.5,1.0" />

    <scenario
        id="1"
        name="music"
        native_scenario="1"
        music_mode="1"
        movie_mode="0"
        surround_3d="false"
        surround_level="35"
        vocal_level="0"
        eq_db="3.5,2.5,1.0,0.0,-0.5,0.5,1.5,2.5,3.0,2.0" />

    <scenario
        id="2"
        name="movie"
        native_scenario="2"
        music_mode="0"
        movie_mode="1"
        surround_3d="true"
        surround_level="65"
        vocal_level="35"
        eq_db="4.5,3.0,1.0,-0.5,0.5,2.0,2.5,2.0,2.5,1.5" />
</misound_profiles>
